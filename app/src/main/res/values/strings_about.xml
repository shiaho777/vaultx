    <string name="about_section_privacy">Privacy</string>
    <string name="about_privacy_no_collection">Zero data collection: no analytics, no tracking, no ads, no accounts.</string>
    <string name="about_privacy_no_network">Zero network access: the app holds no INTERNET permission and never connects to the internet. Links on this page open in your own browser.</string>
    <string name="about_privacy_local_storage">Your files and keys stay only in the app\'s private storage on this device.</string>
    <string name="about_privacy_no_recovery">No password recovery: if you forget the master password, no one can recover your data.</string>
    <string name="about_privacy_backup">Backups are your responsibility: keep encrypted backups safe — losing the device without a backup means losing the data.</string>

