<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_vault"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_new_vault">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.vaultx.app"
            android:targetClass="io.vaultx.app.MainActivity"
            android:data="vaultx://shortcut/new-vault" />
    </shortcut>
    <shortcut
        android:shortcutId="session"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_session">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.vaultx.app"
            android:targetClass="io.vaultx.app.MainActivity"
            android:data="vaultx://shortcut/session" />
    </shortcut>
</shortcuts>